{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AtomCode Student",
  "version": "2.0.4",
  "identifier": "dev.atomcode.student",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/prepare-bundle.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "shortDescription": "AtomCode student desktop client",
    "longDescription": "Tauri recreation of the ElectronJS student client (elcetron/) for the AtomCode portal.",
    "targets": ["deb", "rpm", "appimage", "nsis", "msi", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ],
    "resources": {
      "resources/ui": "ui",
      "resources/renderer": "renderer",
      "resources/java-runtime": "java-runtime"
    }
  }
}
