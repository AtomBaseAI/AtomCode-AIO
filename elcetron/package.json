{
  "name": "atomcode-student-desktop",
  "productName": "AtomCode Student",
  "version": "2.0.3",
  "description": "Electron desktop client for the AtomCode student portal (courses, practice, assessments, results).",
  "main": "main.js",
  "homepage": "https://github.com/AtomBaseAI/AtomCode-Repatch",
  "author": {
    "name": "AtomCode",
    "email": "support@atomcode.dev"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "sync:engine": "node scripts/sync-engine-assets.mjs",
    "selftest": "node scripts/selftest-node.mjs",
    "prebuild": "node scripts/sync-engine-assets.mjs",
    "preexport": "node scripts/sync-engine-assets.mjs",
    "preexport:linux": "node scripts/sync-engine-assets.mjs",
    "preexport:win": "node scripts/sync-engine-assets.mjs && node scripts/fix-nsis-arch.mjs",
    "preexport:mac": "node scripts/sync-engine-assets.mjs",
    "preexport:all": "node scripts/sync-engine-assets.mjs",
    "build": "electron-builder --dir",
    "export": "electron-builder",
    "export:linux": "electron-builder --linux",
    "export:win": "electron-builder --win",
    "export:mac": "electron-builder --mac",
    "export:all": "electron-builder --linux --win --mac"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.atomcode.student",
    "productName": "AtomCode Student",
    "asar": true,
    "compression": "normal",
    "afterPack": "scripts/afterpack.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "java-runtime",
        "to": "java-runtime",
        "filter": [
          "runner.js",
          "doppio-wrapper.js"
        ]
      },
      {
        "from": "java-runtime/node_modules",
        "to": "java-runtime/node_modules",
        "filter": [
          "doppiojvm/bin/**",
          "doppiojvm/dist/release-cli/**",
          "doppiojvm/package.json",
          "doppiojvm/vendor/**",
          "browserfs/dist/**",
          "browserfs/package.json",
          "async/**",
          "source-map/**",
          "source-map/package.json",
          "source-map-support/**",
          "pako/**"
        ]
      }
    ],
    "linux": {
      "icon": "renderer/assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "synopsis": "AtomCode student desktop client",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "win": {
      "icon": "renderer/assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AtomCode Student",
      "deleteAppDataOnUninstall": false,
      "license": "scripts/license.txt",
      "include": "scripts/installer.nsh",
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "AtomCode Student ${version}",
      "window": {
        "width": 560,
        "height": 400
      },
      "iconSize": 110,
      "contents": [
        {
          "x": 150,
          "y": 230
        },
        {
          "x": 430,
          "y": 230,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "icon": "renderer/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "identity": null,
      "darkModeSupport": true
    },
    "forceCodeSigning": false
  }
}