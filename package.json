{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "set -a; [ -f .env ] && . ./.env; set +a; NODE_OPTIONS=--max-old-space-size=2048 next dev -p 3000 2>&1 | tee dev.log",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build --webpack",
    "build:standalone": "BUILD_STANDALONE=true next build --webpack && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "set -a; [ -f .env ] && . ./.env; set +a; prisma db push --accept-data-loss",
    "db:seed": "set -a; [ -f .env ] && . ./.env; set +a; bun prisma/seed.ts",
    "db:generate": "set -a; [ -f .env ] && . ./.env; set +a; prisma generate",
    "db:migrate": "set -a; [ -f .env ] && . ./.env; set +a; prisma migrate dev",
    "db:reset": "set -a; [ -f .env ] && . ./.env; set +a; prisma migrate reset"
  },
  "engines": {
    "node": ">=20.9.0"
  },
