// AtomCode — unified schema (Admin + Staff + Student)
// PostgreSQL (Neon) edition — migrated from the SQLite build.
//
// PostgreSQL optimizations applied on top of the original unified schema:
// 1. datasource provider = "postgresql" (Neon pooler endpoint, sslmode=require).
// 2. Long-form content columns are explicit `@db.Text` (descriptions, source
//    code, judge I/O vectors, user submissions, snippets). Postgres `text`
//    has no length overhead and no silent truncation — ideal for judge data.
// 3. Added the FK indexes Postgres does NOT create automatically:
//    UserCodeQuestionData.questionId and userAssessmentCodeData.questionId
//    (hot paths: cascading deletes and per-question result joins).
// 4. Composite uniques (@@unique([userId, questionId])) double as the
//    userId-prefix lookup index for retake/upsert paths — no duplicate index.
// 5. status/difficulty/lang columns intentionally stay String (not native
//    enums): the UI writes a controlled set of values, but retake / CSV
//    import flows must never hard-fail on a new value. Prisma String maps
//    to Postgres text, which is already the optimal storage.
// 6. No @@map aliases needed — fresh Postgres database, no legacy SQLite
//    table names to preserve.
// 7. Dropped the unused SuperAdmin & malformed Account models (credentials
//    + JWT auth only — no OAuth, so no Account/Session tables required).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  image    String?
  password String
  // Session revocation counter — bumped on password change / forced logout.
  // JWTs freeze the value at sign-in (token.jv); guards compare it against
  // this row (assertSessionValid) so stale sessions stop working.
  tokenVersion Int @default(0)
}

/**
 * Super Admin — platform owner, one level above Admin.
 * - Created by seed / managed from the super admin panel only.
 * - Signs in with email + password, then a static 4-digit auth code
 *   (stored in the Setting KV under "superadmin.authcode").
 * - Everything an Admin can do, plus: manage Admin accounts, the
 *   revenue/billing dashboard and the auth code itself.
 */
model SuperAdmin {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  image    String?
  password String
  // Session revocation counter — see Admin.tokenVersion.
  tokenVersion Int @default(0)
}

/**
 * One annual collection record per batch per year — the billing ledger.
 * status: PENDING (expected) | COLLECTED (cash received from institution).
 * Kept as String like every controlled-value column in this schema.
 */
model BatchBilling {
  id               String    @id @default(cuid())
  batchValue       String
  batch            Batch     @relation(fields: [batchValue], references: [value])
  year             Int
  plan             String    @default("PREMIUM") // FREE | PREMIUM
  amountPerStudent Float
  studentCount     Int       @default(0)
  totalAmount      Float
  status           String    @default("PENDING")
  method           String? // cash
  collectedAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([batchValue, year])
  @@index([year])
  @@index([status])
}

/**
 * Platform settings — simple key-value store edited from the admin
 * settings page (maintenance mode, self-registration toggles, ...).
 * Values are strings ("true"/"false" for flags) so new keys never need
 * a migration; consumers parse through src/lib/platform-settings.ts.
 */
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/**
 * Registration/profile lookup lists managed from Admin → Settings → System.
 * The UI (register forms, student/staff forms, table filters) renders these
 * dynamically instead of hard-coded lists.
 * - Batch.value is the display string (e.g. "2025-2029") stored on User.batch.
 * - Department.value is the stored token on User.department/Staff.department
 *   (kept short, e.g. "cse"), label is the display name (e.g. "CSE").
 *
 * Annual billing (super-admin-only revenue surface): batch wise, NOT per
 * user. Only two plans — FREE (no billing) and PREMIUM. The super admin
 * enables billing per batch and sets a per-student annual amount in INR;
 * the institution collects the cash, so there is NO per-student bill and
 * no billing status on individual students — only one collection record
 * per batch per year (BatchBilling).
 */
model Batch {
  id             String         @id @default(cuid())
  value          String         @unique
  // Billing config (super admin only):
  billingEnabled Boolean        @default(false)
  plan           String         @default("FREE") // FREE | PREMIUM
  annualAmount   Float?                          // INR per student / year (premium only)
  billings       BatchBilling[]
}

model Department {
  id    String @id @default(cuid())
  value String @unique
  label String
}

model Staff {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  phone        String?
  image        String?
  department   String?
  staffnumber  String?
  password     String
  // Session revocation counter — see Admin.tokenVersion.
  tokenVersion Int           @default(0)
  StaffCourse  StaffCourse[]
}

model User {
  id                     String                   @id @default(cuid())
  name                   String?
  department             String?
  section                String?
  batch                  String?
  rollnumber             String?
  github                 String?
  linkedin               String?
  email                  String                   @unique
  phone                  String?
  emailVerified          DateTime?
  image                  String?
  password               String
  isActive               Boolean                  @default(true)
  isTwoFactorEnabled     Boolean                  @default(false)
  // Session revocation counter — see Admin.tokenVersion. Checked together
  // with isActive by assertSessionValid (deactivation also kills sessions).
  tokenVersion           Int                      @default(0)
  userCourses            UserCourse[]
  userModuleData         UserModuleData[]
  userMCQData            UserMCQData[]
  userCodeQuestionData   UserCodeQuestionData[]
  userAssessmentMCQData  userAssessmentMCQData[]
  userAssessmentCodeData userAssessmentCodeData[]
  UserAssessmentData     UserAssessmentData[]
  activityDays           UserActivityDay[]
}

/**
 * Daily activity log powering the student dashboard streaks / heatmap /
 * activity chart. One row per user per app-timezone calendar day
 * ("YYYY-MM-DD" dayKey); `count` increments on every submission event
 * (practice code, practice MCQ, module submit, assessment submit).
 * The submission tables carry no timestamps, so this lightweight counter
 * table is the single source of truth for "active on day X".
 */
model UserActivityDay {
  id        String   @id @default(uuid())
  userId    String
  dayKey    String // "YYYY-MM-DD" in APP_TIMEZONE (Asia/Kolkata)
  count     Int      @default(1)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([userId])
}

model Course {
  id                 String               @id @default(uuid())
  title              String
  startdate          DateTime
  enddate            DateTime
  language           String
  // Course type controls which sections modules/assessments require:
  //   code-mcq  — classic course: MCQ + code both participate in completion
  //   mcq-only  — MCQ-only course: code questions are not mandated (and the
  //               student UI hides the code section) for completion
  courseType         String               @default("code-mcq")
  // anyLanguage — when true, students can solve code questions in ANY of the
  // supported languages (the user code panel shows a language selector);
  // `language` above remains the course's default/preferred language.
  anyLanguage        Boolean              @default(false)
  // How students progress through the course modules:
  //   daywise  — each module unlocks on (and after) its moduledate
  //   queue    — modules unlock strictly in sequence; the next module unlocks
  //              only after the previous one is completed (moduledate ignored)
  //   openflow — all modules open to everyone in any order at any time
  completionOrder    String               @default("openflow")
  userCourses        UserCourse[]
  staffCourses       StaffCourse[]
  assessments        Assessments[]
  modules            Module[]
  userModuleData     UserModuleData[]
  feedbacks          Feedbacks[]
  UserAssessmentData UserAssessmentData[]
}

model Feedbacks {
  id       String   @id @default(uuid())
  courseId String
  title    String
  link     String
  date     DateTime
  Course   Course?  @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

model Module {
  id                   String                 @id @default(uuid())
  title                String
  courseId             String
  course               Course                 @relation(fields: [courseId], references: [id])
  moduledate           DateTime
  // Creation timestamp — defines the deterministic module sequence used by
  // queue-type courses ("previous module" = the one created before this one).
  createdAt            DateTime               @default(now())
  modulestatus         String
  language             String
  maxscore             Int
  concepturl           String?
  // Questions attach to modules through an implicit many-to-many — the
  // SAME question (from any question-group bank) may live in modules of
  // DIFFERENT courses at once. Prisma owns the join tables; attach via
  // relation connect/disconnect, filter via modules: { some: {...} }.
  codeQuestions        CodeQuestion[]         @relation("ModuleCodeQuestions")
  mcqQuestions         MCQQuestion[]          @relation("ModuleMcqQuestions")
  userModuleData       UserModuleData[]
  userMCQData          UserMCQData[]
  userCodeQuestionData UserCodeQuestionData[]
  reference            ModuleReferences[]

  @@index([courseId])
}

model ModuleReferences {
  id       String  @id @default(uuid())
  title    String
  link     String
  type     String
  Module   Module? @relation(fields: [moduleId], references: [id])
  moduleId String?

  @@index([moduleId])
}

model UserModuleData {
  id                 String  @id @default(uuid())
  userId             String
  courseId           String
  moduleId           String
  mcqtime            Int?
  mcqstatus          String?
  usermcqscore       Int?
  totalmcqscore      Int?
  questiontime       Int?
  questionstatus     String?
  userquestionscore  Int?
  totalquestionscore Int?
  errors             Int?
  compiles           Int?
  modulemaxscore     Int?
  modulestatus       String
  user               User    @relation(fields: [userId], references: [id])
  course             Course  @relation(fields: [courseId], references: [id])
  module             Module  @relation(fields: [moduleId], references: [id])

  @@index([userId, courseId, moduleId])
  @@index([courseId])
  @@index([moduleId])
}

model CodeQuestion {
  id                     String                   @id @default(uuid())
  title                  String
  description            String                   @db.Text
  // Modules this question is assigned to (many-to-many) — one question
  // may serve modules of different courses at once.
  modules                Module[]                 @relation("ModuleCodeQuestions")
  sampleinput1           String                   @db.Text
  sampleinput2           String                   @db.Text
  sampleoutput1          String                   @db.Text
  sampleoutput2          String                   @db.Text
  input1                 String                   @db.Text
  input2                 String                   @db.Text
  input3                 String                   @db.Text
  output1                String                   @db.Text
  output2                String                   @db.Text
  output3                String                   @db.Text
  sourcecode             String?                  @db.Text
  referenceimg           String?
  maxscore               Int
  difficulty             String
  lang                   String
  topic                  String?
  subtopic               String?
  inputconstrains        String?                  @db.Text
  blacklist              String?                  @db.Text
  whitelist              String?                  @db.Text
  userCodeQuestionData   UserCodeQuestionData[]
  userAssessmentCodeData userAssessmentCodeData[]
  Assessments            Assessments?             @relation(fields: [assessmentsId], references: [id])
  assessmentsId          String?
  // Every question lives in exactly one question-group bank. Required FK +
  // cascade: deleting a group deletes its questions — no orphans, so the
  // dashboard counts can never outlive their group.
  questionGroupId        String
  questionGroup          QuestionGroup            @relation(fields: [questionGroupId], references: [id], onDelete: Cascade)

  // ── Question classification ─────────────────────────────────────────
  // "practice" | "lab" — lab questions surface company/frequency/acceptance
  // metadata (interview-prep style).
  questionType           String                   @default("practice")
  company                String?
  frequency              String?
  acceptanceRate         Float?

  // ── SQL header code ───────────────────────────────────────────────
  // Optional setup SQL (e.g. CREATE TABLE ...) prepended to the student's
  // code at judge time: header runs first, user code next. Empty for
  // non-SQL questions and optional even for SQL.
  headerCode             String?                  @db.Text

  // Comma-separated topic tags (admin-authored, both question types).
  tags                   String?

  // ── Testcase verification (admin table dots) ─────────────────────────
  // Overall verdict of the last Lambda judge run over all 5 test cases
  // (2 sample + 3 hidden). null = never tested (imported questions).
  testStatus             String?
  // Per-case results JSON: [sample1, sample2, hidden1, hidden2, hidden3] booleans.
  testResults            String?                  @db.Text
  testedAt               DateTime?

  @@index([assessmentsId])
  @@index([questionGroupId])
}

model QuestionGroup {
  id           String         @id @default(uuid())
  title        String
  createdAt    DateTime       @default(now())
  questions    CodeQuestion[]
  mcqQuestions MCQQuestion[]
  topics       Topic[]

  @@index([title])
}

model Topic {
  id        String        @id @default(uuid())
  name      String
  groupId   String
  group     QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subtopics SubTopic[]
  createdAt DateTime      @default(now())

  @@unique([groupId, name])
  @@index([groupId])
}

model SubTopic {
  id      String @id @default(uuid())
  name    String
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, name])
  @@index([topicId])
}

model UserCodeQuestionData {
  id              String       @id @default(uuid())
  userId          String
  questionId      String       @default(cuid())
  moduleId        String
  score           Int
  compiles        Int
  errors          Int
  submissiontype  String
  tabswitches     Int
  status          String
  usercode        String?      @db.Text
  duration        String?
  testcase1status String?
  testcase2status String?
  testcase3status String?
  user            User         @relation(fields: [userId], references: [id])
  codeQuestion    CodeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  module          Module       @relation(fields: [moduleId], references: [id])

  @@unique([userId, questionId])
  @@index([moduleId])
  @@index([userId, moduleId])
  @@index([questionId])
}

model MCQQuestion {
  id              String         @id @default(uuid())
  title           String
  description     String         @db.Text
  topic           String?
  subtopic        String?
  Option1         String
  Option2         String
  Option3         String
  Option4         String
  CorrectOption   Int
  // Modules this MCQ is assigned to (many-to-many) — one MCQ may serve
  // modules of different courses at once.
  modules         Module[]       @relation("ModuleMcqQuestions")
  referenceimg    String?
  codesnippet     String?        @db.Text
  snippetLang     String?
  iscodesnippet   Boolean
  /** "easy" | "medium" | "hard" — mirrors CodeQuestion.difficulty. */
  difficulty      String         @default("easy")
  Assessments     Assessments?   @relation(fields: [assessmentsId], references: [id])
  assessmentsId   String?
  // Every MCQ lives in exactly one question-group bank (cascade on group
  // delete — same contract as CodeQuestion).
  questionGroupId String
  questionGroup   QuestionGroup  @relation(fields: [questionGroupId], references: [id], onDelete: Cascade)

  // Comma-separated topic tags.
  tags            String?

  @@index([assessmentsId])
  @@index([questionGroupId])
}

model UserMCQData {
  id             String  @id @default(uuid())
  userId         String
  moduleId       String
  score          Int
  errors         Int
  submissiontype String
  tabswitches    Int
  status         String
  duration       String?
  user           User    @relation(fields: [userId], references: [id])
  module         Module  @relation(fields: [moduleId], references: [id])

  @@index([userId, moduleId])
  @@index([moduleId])
}

model StaffCourse {
  id       String  @id @default(uuid())
  staffId  String
  courseId String
  active   Boolean
  staff    Staff   @relation(fields: [staffId], references: [id])
  course   Course  @relation(fields: [courseId], references: [id])

  // One assignment per (staff, course) — repeated "Assign" clicks must be
  // idempotent, duplicate rows were breaking the keyed course-staff table.
  @@unique([staffId, courseId])
  @@index([staffId])
  @@index([courseId])
}

model UserCourse {
  id                   String  @id @default(uuid())
  userId               String
  courseId             String
  active               Boolean
  completionPercentage Float
  user                 User    @relation(fields: [userId], references: [id])
  course               Course  @relation(fields: [courseId], references: [id])

  // One enrollment per (user, course) — repeated "Assign" clicks must be
  // idempotent, duplicate rows were breaking the keyed course-student table.
  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Assessments {
  id                     String                   @id @default(uuid())
  title                  String
  date                   DateTime
  accesskey              Int
  language               String
  courseId               String
  maxtime                String
  active                 Boolean
  maxscore               Int
  tabswitches            Int
  course                 Course                   @relation(fields: [courseId], references: [id])
  mcqQuestions           MCQQuestion[]
  codeQuestions          CodeQuestion[]
  UserAssessmentData     UserAssessmentData[]
  userAssessmentMCQData  userAssessmentMCQData[]
  userAssessmentCodeData userAssessmentCodeData[]

  @@index([courseId])
}

model userAssessmentMCQData {
  id             String      @id @default(uuid())
  userId         String
  assessmentId   String
  score          Int
  errors         Int
  submissiontype String
  status         String
  duration       String?
  user           User        @relation(fields: [userId], references: [id])
  assessments    Assessments @relation(fields: [assessmentId], references: [id])

  @@index([userId, assessmentId])
  @@index([assessmentId])
}

model userAssessmentCodeData {
  id              String       @id @default(uuid())
  userId          String
  questionId      String       @default(cuid())
  assessmentId    String
  score           Int
  compiles        Int
  errors          Int
  submissiontype  String
  status          String
  usercode        String?      @db.Text
  duration        String?
  testcase1status String?
  testcase2status String?
  testcase3status String?
  user            User         @relation(fields: [userId], references: [id])
  codeQuestion    CodeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  assessments     Assessments  @relation(fields: [assessmentId], references: [id])

  @@unique([userId, questionId])
  @@index([assessmentId])
  @@index([userId, assessmentId])
  @@index([questionId])
}

model UserAssessmentData {
  id                      String      @id @default(uuid())
  userId                  String
  courseId                String
  assessmentId            String
  mcqtime                 Int?
  mcqstatus               String?
  usermcqscore            Int?
  totalmcqscore           Int?
  questiontime            Int?
  questionstatus          String?
  userquestionscore       Int?
  totalquestionscore      Int?
  errors                  Int?
  compiles                Int?
  assessmentmaxscore      Int?
  assessmentstarttime     String
  userassessmentstarttime String
  usertabswitches         Int
  maxtabswitches          Int
  submissiontype          String?
  status                  String
  maxtime                 String
  userduration            String?
  user                    User        @relation(fields: [userId], references: [id])
  course                  Course      @relation(fields: [courseId], references: [id])
  assessments             Assessments @relation(fields: [assessmentId], references: [id])

  @@index([userId])
  @@index([assessmentId])
  @@index([userId, assessmentId])
  @@index([courseId])
}
